<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navDrawerLayout"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/pbg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_nav_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp"
        android:background="@android:color/transparent">

        <View
            android:id="@+id/top_spacer"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/nav_profile_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_profile_placeholder"
            android:contentDescription="User Profile Image"
            android:scaleType="centerCrop"
            android:padding="4dp"
            app:tint="@null"
            app:layout_constraintTop_toBottomOf="@id/top_spacer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp"

            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:strokeWidth="1dp"
            app:strokeColor="@color/white"
            />

        <TextView
            android:id="@+id/nav_welcome_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/nav_username"
            app:layout_constraintStart_toEndOf="@id/nav_profile_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="@+id/nav_profile_image" />

        <TextView
            android:id="@+id/nav_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Service Pro"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/nav_welcome_text"
            app:layout_constraintStart_toStartOf="@id/nav_welcome_text"
            app:layout_constraintEnd_toEndOf="@id/nav_welcome_text"
            app:layout_constraintBottom_toBottomOf="@+id/nav_profile_image"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/btnMessages"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Messages">

                <ImageView
                    android:id="@+id/ivMessagesIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/message"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvMessagesText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Messages"
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnServiceRequest"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Service Requests">
                <ImageView
                    android:id="@+id/ivServicesIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/services"
                    app:tint="@color/white"
                    />

                <TextView
                    android:id="@+id/tvServiceRequestText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Service Request"
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnBubbles"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Bubbles AI">

                <ImageView
                    android:id="@+id/ivBubblesIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/ai"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvBubblesText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Chat with Bubbles"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnLoadshedding"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Load Shedding Alerts">

                <ImageView
                    android:id="@+id/ivLoadsheddingIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/loadshedding"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvLoadsheddingText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Load Shedding Alerts"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnRestrictions"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Water Restrictions">

                <ImageView
                    android:id="@+id/ivRestrictionsIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/water_restriction"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvRestrictionsText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Water Restrictions"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHelp"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Help &amp; Support">

                <ImageView
                    android:id="@+id/ivHelpIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/help"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvHelpText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Help &amp; Support"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                style="@style/NavDrawerMenuItemStyle"
                android:contentDescription="Settings">

                <ImageView
                    android:id="@+id/ivSettingsIcon"
                    style="@style/NavDrawerMenuItemIconStyle"
                    android:src="@drawable/settings"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvSettingsText"
                    style="@style/NavDrawerMenuItemTextStyle"
                    android:text="Settings"
                    android:textColor="@color/white" />
            </LinearLayout>



            <View android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/black" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:background="@android:color/transparent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/facebook"
            android:contentDescription="Facebook"
            android:layout_marginHorizontal="12dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/linkedin"
            android:contentDescription="LinkedIn"
            android:layout_marginHorizontal="12dp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/instagram"
            android:contentDescription="Instagram"
            android:layout_marginHorizontal="12dp"/>

    </LinearLayout>

</LinearLayout>