<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".PO_AddPool">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/white"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <LinearLayout
                android:id="@+id/poolNameLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_pool_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Pool Name (e.g., My Oasis)"
                    android:inputType="textCapWords"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_dark"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Pool Icon"
                    android:src="@drawable/pool" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/poolTypeLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_pool_type"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="Pool Type (In-ground, Above-ground)"
                    android:inputType="none"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_dark"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Dropdown Icon"
                    android:src="@drawable/pooltype" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/waterCapacityLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_water_capacity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Water Capacity (liters, or best estimate)"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_dark"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Capacity Icon"
                    android:src="@drawable/water_capacity" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sanitizerLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_sanitizer_type"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="Sanitizer Type (Chlorine or Salt Chlorinator)"
                    android:inputType="none"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_dark"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Dropdown Icon"
                    android:src="@drawable/chlorine" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/runtimeLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <EditText
                    android:id="@+id/et_filter_runtime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Pump Run Time (Hours per day, e.g., 4 or 8)"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_dark"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Timer Icon"
                    android:src="@drawable/water_clock" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/locationSelectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Enable Pool Location"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Switch
                        android:id="@+id/switch_location_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/ll_location_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        tools:text="Status: Permission granted. Ready to fetch." />

                    <TextView
                        android:id="@+id/tv_location_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="italic"
                        tools:text="Address: City, Country" />

                    <TextView
                        android:id="@+id/tv_coordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_dark"
                        android:textSize="12sp"
                        tools:text="Coordinates: Lat: 34.0000, Lng: -118.0000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fetch_location"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="Get Current Location"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/location"
                        app:iconTint="@color/colorPrimary" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/visibilitySelectionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/rounded_input_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Make Pool Publicly Visible"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allows Service Providers to find this pool for service requests."
                            android:textColor="@color/grey_dark"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_is_public"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="false" />
                </RelativeLayout>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_image_container"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:id="@+id/ll_upload_photos_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/dashed_border_area"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="4dp"
                        android:contentDescription="Upload Icon"
                        android:src="@drawable/camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Photo"
                        android:textColor="@color/grey_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optional: Helps service providers diagnose issues"
                        android:textColor="@color/grey_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_selected_pool_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected Pool Photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_delete_photo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/circle_red_background"
                    android:contentDescription="Delete Photo"
                    android:padding="4dp"
                    android:src="@drawable/ic_delete_circle"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_pool"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"  android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"  android:background="@drawable/custom_button"
                android:text="Add Pool"
                android:textColor="@color/white"
                android:textSize="18dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/white_transparent_50" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_pool"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="0dp"  android:layout_marginBottom="16dp"
                android:background="@drawable/custom_button2"
                android:paddingVertical="12dp"
                android:text="Delete Pool"
                android:textColor="@color/white"
                android:textSize="18dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/white_transparent_50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="250dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="0dp"  android:layout_marginBottom="16dp"
                android:background="@drawable/custom_button2"
                android:paddingVertical="12dp"
                android:text="Cancel"
                android:textColor="@color/white"
                android:textSize="18dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/white_transparent_50" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>