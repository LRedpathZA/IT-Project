<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pbg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.weather.ForecastFragment">

        <TextView
            android:id="@+id/tv_forecast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="5-Day Forecast"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_daily_forecast"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"

            android:nestedScrollingEnabled="false"

            app:layout_constraintTop_toBottomOf="@id/tv_forecast_title"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_daily_forecast" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>