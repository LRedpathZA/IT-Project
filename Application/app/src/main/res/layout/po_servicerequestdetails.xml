<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pbg"
    tools:context=".PO_ServiceRequestDetails">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:layout_marginTop="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_detail_request_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        tools:text="Filter/Pump Equipment Repair" />

                    <TextView
                        android:id="@+id/tv_detail_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/rounded_status_open"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        tools:text="Quotes Received (3)" />

                    <TextView
                        android:id="@+id/tv_detail_pool_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_dark"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"
                        tools:text="Pool: My Backyard Oasis | Pretoria West" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/grey_light"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Problem Description:"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_dark"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"
                        tools:text="The pump has been making a loud grinding noise for two days, and the water flow is very weak. I suspect a bearing failure or a blockage." />

                    <ImageView
                        android:id="@+id/iv_detail_photo"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        android:background="@color/grey_light"
                        android:contentDescription="Photo of the problem" />

                    <TextView
                        android:id="@+id/tv_detail_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_dark"
                        android:textSize="12sp"
                        tools:text="Posted: 2025/10/25 | Expires: 2025/11/01" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_quotes_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quotes Received (0)"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/layout_quote_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_input_bg">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_quotes"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    app:icon="@drawable/ic_filter"
                    app:iconTint="@color/black"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    android:minWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sort_quotes"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort by Price (Low to High)"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    app:icon="@drawable/sort"
                    app:iconTint="@color/black"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_quotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_quote_card" />

            <TextView
                android:id="@+id/tv_no_quotes_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No service quotes have been received yet. Check back later!"
                android:textColor="@color/grey_dark"
                android:textSize="16sp"
                android:gravity="center"
                android:paddingVertical="32dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>