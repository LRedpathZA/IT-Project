<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".ChlorineCalculator">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@android:color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chlorine Dose Calculator"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required Inputs"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/currentChlorineLayout"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/rounded_input_bg">
                        <EditText
                            android:id="@+id/et_current_chlorine"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Current Chlorine Level (e.g., 0.5) *"
                            android:inputType="numberDecimal"
                            android:maxLength="4"
                            android:background="@android:color/transparent"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="16sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ppm"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="4dp"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/chlorine"
                            app:tint="@color/black"
                            android:contentDescription="Chlorine Icon"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/targetChlorineLayout"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/rounded_input_bg">
                        <EditText
                            android:id="@+id/et_target_chlorine"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Target Chlorine (Ideal 2.0 - 3.0)"
                            android:inputType="numberDecimal"
                            android:maxLength="4"
                            android:background="@android:color/transparent"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="16sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ppm"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="4dp"/>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/water_drop"
                            app:tint="@color/black"
                            android:contentDescription="Target Icon"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/poolVolumeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:background="@drawable/rounded_input_bg">
                        <EditText
                            android:id="@+id/et_pool_volume_chl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Pool Volume *"
                            android:inputType="numberDecimal"
                            android:maxLength="10"
                            android:background="@android:color/transparent"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="16sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="L"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/water_capacity"
                            app:tint="@color/black"
                            android:contentDescription="Volume Icon"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chlorine Type"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_chlorine_type"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select Chlorine Product">

                        <AutoCompleteTextView
                            android:id="@+id/actv_chlorine_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            tools:text="Liquid Chlorine (10%)"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Note: Granular (Calcium Hypochlorite) will raise pH and Alkalinity."
                        android:textColor="@color/PrimaryColour"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_chemical_info_chl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chlorine Guidelines &amp; Safety"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_chlorine_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a chlorine product above to see safety instructions, strength details, and application procedures."
                        android:textColor="@color/grey_dark"
                        android:textSize="14sp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_result_chl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardBackgroundColor="@color/black">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required Dosage"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tv_dosage_result_chl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="750 ml of Liquid Chlorine"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_log_chl"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Test Log"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/PrimaryColour"
                        app:rippleColor="@color/white_transparent_50"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_calculate_chl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Dosage"
                android:paddingVertical="12dp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/PrimaryColour"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>