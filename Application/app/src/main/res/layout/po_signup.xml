<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".PO_SignUp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/Header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register your individual account"
            android:textSize="26sp"
            android:textColor="@android:color/black"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp" />

        <!-- Username -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_input_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/usernameEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="User Name"
                android:background="@android:color/transparent"
                android:inputType="textPersonName"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/usernameIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/profile"

            android:contentDescription="User icon"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_input_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Email Address"
                android:background="@android:color/transparent"
                android:inputType="textEmailAddress"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/emailIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/email"
            android:contentDescription="Email icon"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_input_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Password"
                android:background="@android:color/transparent"
                android:inputType="textPassword"
                android:padding="8dp" />

            <ImageView
                android:id="@+id/passwordIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/hide"

            android:contentDescription="Password icon"
            android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Terms Checkbox -->
        <CheckBox
            android:id="@+id/termsCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I accept the terms of service"
            android:textColor="@android:color/darker_gray"
            android:textSize="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signupButton"
            android:layout_width="304dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/custom_button2"
            android:paddingVertical="12dp"
            android:text="Sign Up"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/optionsRow"
            app:rippleColor="@color/white_transparent_50" />


        <!-- Login Link -->
        <TextView
            android:id="@+id/loginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Log In"
            android:textColor="#0A57FF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:textSize="16dp"/>

        <!-- Business Link -->
        <TextView
            android:id="@+id/businessLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partner with us. Register your business"
            android:textColor="#0A57FF"
            android:textSize="16dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>
</ScrollView>
