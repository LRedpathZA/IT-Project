<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="140dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_pool_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_wavy_background_placeholder"
            android:contentDescription="Pool Photo" />

        <TextView
            android:id="@+id/tv_pool_capacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_transparent_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:drawablePadding="2dp"
            android:drawableStart="@drawable/ic_water_drop_white_16dp"
            android:text="5000L"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@color/black_transparent_50"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_pool_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Backyard Oasis"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_pool_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In-ground | Chlorine"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_pool_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123 Main Street"
                android:textColor="@color/grey_light"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>