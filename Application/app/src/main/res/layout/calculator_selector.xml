                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/rounded_icon_bg_purple"
                    android:src="@drawable/alkalinity"
                    app:tint="@color/white"
                    android:contentDescription="Alkalinity Calculator Icon"/>
                <LinearLayout
